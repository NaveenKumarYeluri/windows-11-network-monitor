<Window
    x:Class="Windows11NetworkMonitor.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <ScrollViewer Margin="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="560">

            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

            <StackPanel Spacing="6">
                <TextBlock Text="Adapter mode" FontWeight="SemiBold" />
                <ComboBox x:Name="AdapterModeCombo" PlaceholderText="Auto" IsEditable="True" MinWidth="280" HorizontalAlignment="Stretch" />
                <TextBlock Text="Auto = auto-select. Combined = sum all. Or pick an adapter. Click Save, then restart." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Poll interval (ms)" FontWeight="SemiBold" />
                <NumberBox x:Name="PollIntervalBox" Minimum="250" Maximum="5000" SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Theme" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeCombo" MinWidth="280" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="System (follow Windows)" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Usage history retention (days)" FontWeight="SemiBold" />
                <NumberBox x:Name="HistoryRetentionBox" Minimum="0" Maximum="365" Value="90" SpinButtonPlacementMode="Inline" />
                <TextBlock Text="How long to keep daily download/upload totals. 90 days = 3 months, 180 days = 6 months, 0 = keep forever. Old days are pruned automatically." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <CheckBox x:Name="ShowTrayCheck" Content="Show tray icon" />
            <CheckBox x:Name="ShowHudCheck" Content="Show taskbar HUD" />
            <CheckBox x:Name="ShowGraphCheck" Content="Show graph" />
            <CheckBox x:Name="TrackPerAppCheck" Content="Track per-app usage (estimated)" />
            <CheckBox x:Name="IncludeVirtualCheck" Content="Include virtual adapters (VPN / VMware)" />
            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" />

            <Button x:Name="SaveButton" Content="Save" HorizontalAlignment="Left" Click="SaveButton_Click" />
            <TextBlock x:Name="StatusText" Opacity="0.7" />

        </StackPanel>
    </ScrollViewer>
</Window>
