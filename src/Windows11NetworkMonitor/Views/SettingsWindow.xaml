<Window
    x:Class="Windows11NetworkMonitor.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <ScrollViewer Margin="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="560">

            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

            <StackPanel Spacing="6">
                <TextBlock Text="Adapter mode" FontWeight="SemiBold" />
                <ComboBox x:Name="AdapterModeCombo" PlaceholderText="Auto" IsEditable="True" MinWidth="280" HorizontalAlignment="Stretch" />
                <TextBlock Text="Auto = auto-select. Combined = sum all. Or pick an adapter. Click Save, then restart." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Poll interval (ms)" FontWeight="SemiBold" />
                <NumberBox x:Name="PollIntervalBox" Minimum="250" Maximum="5000" SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Theme" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeCombo" MinWidth="280" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="System (follow Windows)" Tag="System" />
                    <ComboBoxItem Content="Light" Tag="Light" />
                    <ComboBoxItem Content="Dark" Tag="Dark" />
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Taskbar HUD dock" FontWeight="SemiBold" />
                <ComboBox x:Name="HudDockCombo" MinWidth="280" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Bottom (end near system tray)" Tag="Bottom" />
                    <ComboBoxItem Content="Top" Tag="Top" />
                    <ComboBoxItem Content="Left" Tag="Left" />
                    <ComboBoxItem Content="Right" Tag="Right" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <NumberBox x:Name="HudOffsetXBox" Header="Horizontal offset (DIP, ±)" Minimum="-500" Maximum="500" SpinButtonPlacementMode="Inline" MinWidth="150" />
                    <NumberBox x:Name="HudOffsetYBox" Header="Vertical offset (DIP, ±)" Minimum="-500" Maximum="500" SpinButtonPlacementMode="Inline" MinWidth="150" />
                </StackPanel>
                <TextBlock Text="Bottom = over the taskbar, just left of the clock and the ^ tray arrow (their actual width is measured, so they are never covered). Top = top edge of the screen. Left / Right = mid-height of the screen sides. Offsets (±500 DIP, DPI-scaled) fine-tune the position and apply the moment you Save — no restart." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Usage history retention (days)" FontWeight="SemiBold" />
                <NumberBox x:Name="HistoryRetentionBox" Minimum="0" Maximum="365" Value="90" SpinButtonPlacementMode="Inline" />
                <TextBlock Text="How long to keep daily download/upload totals. 90 days = 3 months, 180 days = 6 months, 0 = keep forever. Old days are pruned automatically." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Daily usage alert (GB)" FontWeight="SemiBold" />
                <NumberBox x:Name="DailyLimitBox" Minimum="0" Maximum="9999" Value="0" SpinButtonPlacementMode="Inline" />
                <TextBlock Text="Warn via a tray notification when daily usage (download + upload combined) reaches 90% of the limit, and again at the limit. 0 = off. Applies on the next tick — no restart." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <CheckBox x:Name="ShowHudCheck" Content="Show taskbar HUD" />
            <CheckBox x:Name="ShowGraphCheck" Content="Show graph" />
            <CheckBox x:Name="TrackPerAppCheck" Content="Track per-app usage (estimated)" />
            <CheckBox x:Name="IncludeVirtualCheck" Content="Include virtual adapters (VPN / VMware)" />
            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" />

            <Button x:Name="SaveButton" Content="Save" HorizontalAlignment="Left" Click="SaveButton_Click" />

            <StackPanel Spacing="6">
                <TextBlock Text="Export" FontWeight="SemiBold" />
                <Button x:Name="ExportCsvButton" Content="Export history to CSV" HorizontalAlignment="Left" Click="ExportCsvButton_Click" />
                <TextBlock Text="Writes all daily totals (device + per-app) to a CSV file under %LOCALAPPDATA%\Windows11NetworkMonitor\exports and opens the folder in Explorer." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Opacity="0.7" />

        </StackPanel>
    </ScrollViewer>
</Window>
