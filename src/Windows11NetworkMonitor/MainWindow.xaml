<Window
    x:Class="Windows11NetworkMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008/2006"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows 11 Network Monitor">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <NavigationView x:Name="Nav" Grid.Column="0" PaneDisplayMode="Left" OpenPaneLength="220" IsPaneOpen="True" IsPaneToggleButtonVisible="False" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" IsSelected="True" />
                <NavigationViewItem Content="Adapters" Tag="Adapters" />
                <NavigationViewItem Content="Apps" Tag="Apps" />
                <NavigationViewItem Content="Statistics" Tag="Statistics" />
            </NavigationView.MenuItems>
            <NavigationView.Header>
                <StackPanel Padding="16,16,16,16" Spacing="8">
                    <TextBlock Text="Network Monitor" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Windows 11 Network Monitor" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                    <Button x:Name="OpenSettingsButton" Content="Settings" Margin="0,10,0,0" Click="OpenSettingsButton_Click" />
                </StackPanel>
            </NavigationView.Header>
        </NavigationView>

        <!-- Main content -->
        <ScrollViewer x:Name="MainScroll" Grid.Column="1" Margin="24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" MaxWidth="900">

                <!-- Live speed cards -->
                <Grid x:Name="DashboardSection" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="12" Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="DOWNLOAD" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock x:Name="DownText" Text="0.0 MB/s" FontSize="36" FontWeight="SemiBold" Foreground="#0078D4" />
                            <TextBlock x:Name="AdapterText" Text="Auto" Opacity="0.7" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="12" Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="UPLOAD" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock x:Name="UpText" Text="0.0 MB/s" FontSize="36" FontWeight="SemiBold" Foreground="#D83B01" />
                            <TextBlock x:Name="LatencyText" Text="Latency: -- ms" Opacity="0.7" />
                            <TextBlock x:Name="WifiText" Text="" Opacity="0.7" Visibility="Collapsed" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Graph -->
                <Border x:Name="GraphSection" CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Live graph" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <RadioButton x:Name="Range60Btn" Content="1 min" GroupName="GraphRange" IsChecked="True" Checked="GraphRange_Changed" Tag="60" Style="{StaticResource DefaultRadioButtonStyle}" MinWidth="0" Padding="10,2" />
                                <RadioButton x:Name="Range300Btn" Content="5 min" GroupName="GraphRange" Checked="GraphRange_Changed" Tag="300" Style="{StaticResource DefaultRadioButtonStyle}" MinWidth="0" Padding="10,2" />
                                <RadioButton x:Name="Range900Btn" Content="15 min" GroupName="GraphRange" Checked="GraphRange_Changed" Tag="900" Style="{StaticResource DefaultRadioButtonStyle}" MinWidth="0" Padding="10,2" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Y-axis labels -->
                            <Grid Grid.Column="0">
                                <TextBlock x:Name="MaxLabel" Text="0 B/s" FontSize="11" Opacity="0.7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock x:Name="MidLabel" Text="0 B/s" FontSize="11" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock x:Name="MinLabel" Text="0 B/s" FontSize="11" Opacity="0.7" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </Grid>
                            <Canvas x:Name="GraphCanvas" Grid.Column="1" Height="220" Background="Transparent"
                                    Tapped="GraphCanvas_Tapped"
                                    PointerMoved="GraphCanvas_PointerMoved"
                                    PointerExited="GraphCanvas_PointerExited"
                                    SizeChanged="GraphCanvas_SizeChanged">
                                <Canvas x:Name="GraphGrid" />
                                <!-- gradient area fills (built in code-behind) -->
                                <Path x:Name="DownArea" StrokeThickness="0" Opacity="0.35" />
                                <Path x:Name="UpArea" StrokeThickness="0" Opacity="0.35" />
                                <Polyline x:Name="DownLine" Stroke="#0078D4" StrokeThickness="2" StrokeLineJoin="Round" />
                                <Polyline x:Name="UpLine" Stroke="#D83B01" StrokeThickness="2" StrokeLineJoin="Round" />
                                <!-- crosshair + hover markers (hidden until pointer over) -->
                                <Line x:Name="HoverLine" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" StrokeDashArray="2 2" Visibility="Collapsed" Y1="0" Y2="220" />
                                <Ellipse x:Name="HoverDotDown" Width="8" Height="8" Fill="#0078D4" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                <Ellipse x:Name="HoverDotUp" Width="8" Height="8" Fill="#D83B01" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2" Visibility="Collapsed" />
                                <Border x:Name="HoverCard" CornerRadius="6" Padding="8,6" Visibility="Collapsed"
                                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="HoverTime" FontSize="11" Opacity="0.7" />
                                        <TextBlock x:Name="HoverDown" FontSize="12" Foreground="#0078D4" />
                                        <TextBlock x:Name="HoverUp" FontSize="12" Foreground="#D83B01" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" Fill="#0078D4" VerticalAlignment="Center" />
                                <TextBlock Text="Download" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="10" Height="10" Fill="#D83B01" VerticalAlignment="Center" />
                                <TextBlock Text="Upload" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Adapters -->
                <Border x:Name="AdaptersSection" CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Adapters (auto-detected)" FontWeight="SemiBold" />
                        <StackPanel x:Name="AdapterPanel" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- Stats -->
                <Border x:Name="StatsSection" CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Statistics" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Session ↓ / ↑" Opacity="0.7" />
                                <TextBlock x:Name="SessionText" Text="0 MB / 0 MB" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Today ↓ / ↑" Opacity="0.7" />
                                <TextBlock x:Name="DailyText" Text="0 MB / 0 MB" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Peak ↓ / ↑ / Avg" Opacity="0.7" />
                                <TextBlock x:Name="PeakText" Text="0 / 0 / 0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="History chart" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <RadioButton x:Name="StatsRange7Btn" Content="7 days" GroupName="StatsRange" Checked="StatsRange_Changed" Tag="7" Style="{StaticResource DefaultRadioButtonStyle}" MinWidth="0" Padding="10,2" />
                                    <RadioButton x:Name="StatsRange30Btn" Content="30 days" GroupName="StatsRange" IsChecked="True" Checked="StatsRange_Changed" Tag="30" Style="{StaticResource DefaultRadioButtonStyle}" MinWidth="0" Padding="10,2" />
                                    <RadioButton x:Name="StatsRange90Btn" Content="90 days" GroupName="StatsRange" Checked="StatsRange_Changed" Tag="90" Style="{StaticResource DefaultRadioButtonStyle}" MinWidth="0" Padding="10,2" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBlock x:Name="ChartMax" Text="0" FontSize="11" Opacity="0.7" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,8,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ChartMid" Text="0" FontSize="11" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ChartMin" Text="0" FontSize="11" Opacity="0.7" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,0" TextWrapping="Wrap" />
                                </Grid>
                                <Canvas x:Name="ChartCanvas" Grid.Column="1" Height="170" />
                            </Grid>
                            <TextBlock Text="Stacked daily bars (tap a bar for that day's per-app breakdown). The thin line is the 7-day moving average. Blue = download, orange = upload." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                            <!-- Per-day breakdown (shown when a bar is tapped) -->
                            <StackPanel x:Name="DayDetailPanel" Spacing="2" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock x:Name="DayDetailTitle" FontWeight="SemiBold" />
                                    <HyperlinkButton x:Name="DayDetailHide" Content="hide" Padding="0" Click="DayDetailHide_Click" />
                                </StackPanel>
                                <StackPanel x:Name="DayDetailApps" Spacing="2" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Trends -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Trends" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="8" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="This week vs last" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        <TextBlock x:Name="WeekTotal" Text="0" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WeekDelta" Text="—" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="8" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Month-to-date vs last month" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MonthTotal" Text="0" FontWeight="SemiBold" />
                                        <TextBlock x:Name="MonthDelta" Text="—" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="8" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Projected month-end" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        <TextBlock x:Name="ProjectionText" Text="0" FontWeight="SemiBold" />
                                        <TextBlock Text="at the current pace" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" CornerRadius="8" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Best day / daily avg" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                        <TextBlock x:Name="BestDayText" Text="0" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AvgDayText" Text="avg 0/day" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock x:Name="DailyListTitle" Text="Daily totals (last 30 days)" FontWeight="SemiBold" />
                            <!-- StackPanel (not ListView) inside outer ScrollViewer so outer page scrolls once and rows never snap to top -->
                            <StackPanel x:Name="HistoryPanel" Spacing="2" />
                            <TextBlock Text="Weekly totals (last 12 weeks)" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <StackPanel x:Name="WeeklyPanel" Spacing="2" />
                            <TextBlock Text="Monthly totals (last 12 months)" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <StackPanel x:Name="MonthlyPanel" Spacing="2" />
                            <TextBlock Text="Top app today (accumulated estimate):" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <StackPanel x:Name="TopAppsPanel" Spacing="2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Apps -->
                <Border x:Name="AppsSection" CornerRadius="12" Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Apps using network now" FontWeight="SemiBold" />
                        <StackPanel x:Name="AppPanel" Spacing="2" />
                        <TextBlock Text="Estimated by live connections — for byte-accurate counts Windows runs a WFP callout driver (admin), out of scope for this build." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
